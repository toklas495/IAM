{
  "compilerOptions": {
    /* Project Structure */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Node.js Environment */
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],

    /* Interop & Runtime */
    "types": ["node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,

    /* Output Quality */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* Strictness (Backend-grade) */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Build Safety */
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",

    /* Performance */
    "skipLibCheck": true
  },

  "include": ["src", "env"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
